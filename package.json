{
  "name": "claude-telegram",
  "version": "0.1.0",
  "description": "Drive Claude Code from Telegram: one daemon bridges every session over a shared bot, with a topic per project, rich streamed answers and a live pinned status.",
  "type": "module",
  "bin": {
    "cctg": "./dist/cli.js"
  },
  "files": [
    "dist",
    "plugin",
    "README.md"
  ],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.22.0",
    "@yaebal/commands": "^1.0.0",
    "@yaebal/rich": "^1.0.0",
    "@yaebal/throttle": "^1.0.0",
    "yaebal": "^0.2.0"
  },
  "devDependencies": {
    "@yaebal/test": "^1.0.0",
    "bun-types": "^1.4.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flxxxxddd/claude-telegram.git"
  },
  "homepage": "https://github.com/flxxxxddd/claude-telegram#readme",
  "bugs": {
    "url": "https://github.com/flxxxxddd/claude-telegram/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "telegram",
    "telegram-bot",
    "mcp",
    "yaebal"
  ]
}
